# 환경 변수 템플릿 파일
# 이 파일을 복사하여 .env.local 파일을 생성하고 값을 입력하세요

# API 서버 기본 URL (백엔드 서버 주소로 변경)
VITE_API_BASE_URL=http://localhost:8080

# 개발 모드 플래그
VITE_DEV_MODE=true

# MSW(Mock Service Worker) 활성화 플래그
# - true: 개발 환경에서 MSW로 API 모킹 활성화
# - false: 개발 환경에서도 실제 백엔드로 요청 전송 (기본값)
VITE_ENABLE_MSW=false

# Naver Maps JavaScript SDK Key ID
VITE_NAVER_MAP_KEY_ID=your_naver_map_key_id_here

# Naver Maps Secret Key 등 민감 정보는 백엔드에서 관리
